{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zcode-self-hosted-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-11",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true,
    "html_handling": "none",
  },
  "r2_buckets": [{ "binding": "REMOTE_WEB_ARCHIVE", "bucket_name": "zcode-remote-web-assets" }],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "RelayRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayRoom"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
